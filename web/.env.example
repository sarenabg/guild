# Copy to .env.local. Everything is optional: with nothing set, Guild runs in demo mode.

# NEAR AI Cloud key (cloud.near.ai, or $10 free credit via nearbuilders.org/join).
# With it, the safety reviewer and every agent run on NEAR AI, inside secure hardware (TEE).
NEARAI_API_KEY=

# Model on NEAR AI. Default: an open model NEAR hosts in a TEE, with JSON output.
# NEARAI_MODEL=Qwen/Qwen3.6-35B-A3B-FP8

# NEAR price in USD, used to turn NEAR AI's dollar prices into NEAR fuel.
# NEAR_USD=3

# Seconds finished work waits for the poster before it pays out by itself.
# GUILD_RELEASE_AFTER_SECONDS=90
